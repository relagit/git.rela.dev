---
import "@pagefind/default-ui/css/ui.css";
import { getCollection, getEntry } from "astro:content";

import Layout from "./Layout.astro";
import Header from "~/components/Header.astro";
import RecursiveDocsMap, { type DocsMap } from "~/components/RecursiveDocsMap";
import DefaultHead from "~/layouts/DefaultHead.astro";
import Icon from "~/components/Icon";

import { readTime } from "~/utils/time";

interface Props {
    post: string;
}

const { post } = Astro.props;

const allDocs = await getCollection("docs");

const entry = await getEntry("docs", post);

if (!entry) {
    throw new Error(`Could not find entry for ${post}`);
}

const { Content, headings } = await entry.render();

import "./docs.scss";

const time = readTime(entry.body.split(" ").length / 125);

let docsMap: DocsMap = [];

for (const doc of allDocs) {
    const parts = doc.slug.split("/");

    parts.pop();

    // we want to generate an array of folders and docs for the sidebar

    let current = docsMap;

    for (const part of parts) {
        const existing = current.find(
            (item) =>
                item.type === "folder" &&
                item.name.replace(" ", "-").toLowerCase() === part,
        );

        if (existing && existing.type === "folder") {
            current = existing.items;
        } else {
            const newFolder = {
                type: "folder",
                name: part
                    .replace(/-/g, " ")
                    .replace(/\b\w/g, (l) => l.toUpperCase()),
                items: [] as DocsMap,
            } as const;

            current.push(newFolder);

            current = newFolder.items;
        }

        if (part === parts[parts.length - 1])
            current.push({
                type: "doc",
                slug: doc.slug,
                data: doc.data,
            });
    }
}

const sort = (level: DocsMap) => {
    return level.sort((a, b) => {
        if (a.type === "folder" && b.type === "doc") {
            return -1;
        }

        if (a.type === "doc" && b.type === "folder") {
            return 1;
        }

        if (a.type === "folder" && b.type === "folder") {
            return a.name.localeCompare(b.name);
        }

        if (a.type === "doc" && b.type === "doc") {
            return a.data.sortOrder - b.data.sortOrder;
        }

        return 0;
    });
};

const recurse = (level: DocsMap): DocsMap => {
    for (const item of level) {
        if (item.type === "folder") {
            item.items = sort(recurse(item.items));
        }
    }

    return level;
};

docsMap = sort(recurse(docsMap));

const flat: {
    type: "doc";
    slug: string;
    data: Awaited<ReturnType<typeof getCollection<"docs">>>[number]["data"];
}[] = (() => {
    const flat: {
        type: "doc";
        slug: string;
        data: Awaited<ReturnType<typeof getCollection<"docs">>>[number]["data"];
    }[] = [];

    const recurse = (docsMap: DocsMap) => {
        for (const item of docsMap) {
            if (item.type === "doc") {
                flat.push(item);
            } else {
                recurse(item.items);
            }
        }
    };

    recurse(docsMap);

    return flat;
})();

const prev = () => {
    const index = flat.findIndex((doc) => doc.slug === post);

    if (index === 0) {
        return null;
    }

    return `/docs/${flat[index - 1].slug}`;
};

const next = () => {
    const index = flat.findIndex((doc) => doc.slug === post);

    if (index === flat.length - 1) {
        return null;
    }

    return `/docs/${flat[index + 1].slug}`;
};
---

<script>
    const headings = document.querySelectorAll(
        `.heading[data-slug="${window.location.hash.slice(1)}"]`,
    );

    if (headings?.length) {
        for (const heading of headings) {
            heading.classList.add("active");
        }
    }

    window.addEventListener("click", (e) => {
        if ((e.target as HTMLElement)?.tagName === "BUTTON") {
            if ((e.target as HTMLElement)?.dataset.code) {
                e.preventDefault();

                navigator.clipboard.writeText(
                    (e.target as HTMLElement)?.dataset.code || "",
                );

                (e.target as HTMLElement)?.classList.add("copied");
            }
        }
    });

    window.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") {
            const prev = document.querySelector(
                ".nav-button:first-child",
            ) as HTMLAnchorElement;

            if (prev && !prev.getAttribute("aria-disabled")) {
                prev.click();
            }
        } else if (e.key === "ArrowRight") {
            const next = document.querySelector(
                ".nav-button:last-child",
            ) as HTMLAnchorElement;

            if (next && !next.getAttribute("aria-disabled")) {
                next.click();
            }
        }
    });

    window.addEventListener("hashchange", () => {
        const active = document.querySelectorAll(".heading.active");

        if (active?.length) {
            for (const heading of active) {
                heading.classList.remove("active");
            }
        }

        const headings = document.querySelectorAll(
            `.heading[data-slug="${window.location.hash.slice(1)}"]`,
        );

        if (headings?.length) {
            for (const heading of headings) {
                heading.classList.add("active");
            }
        }
    });

    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                const id = entry.target.getAttribute("id");
                if (entry.isIntersecting) {
                    document
                        .querySelectorAll(`.heading.active`)
                        ?.forEach((heading) => {
                            heading.classList.remove("active");
                        });
                    document
                        .querySelectorAll(`.heading[data-slug="${id}"]`)
                        ?.forEach((heading) => {
                            heading.classList.add("active");
                        });
                }
            });
        },
        { rootMargin: "0% 0% -60% 0%" },
    );

    document.querySelectorAll("h2, h3, h4, h5, h6").forEach((heading) => {
        observer.observe(heading);
    });
</script>

<Layout title={`RelaGit - ${entry.data.title}`} transitions>
    <DefaultHead slot="head" title={`RelaGit - ${entry.data.title}`}>
        <meta name="description" content={entry.data.description} />
        <meta name="og:description" content={entry.data.description} />
        <meta name="twitter:description" content={entry.data.description} />
        <link rel="canonical" href={`https://rela.dev/docs/${post}`} />
    </DefaultHead>
    <Header embed>
        <div slot="search">
            <div id="search"></div>
            <script>
                window.addEventListener("keydown", (e) => {
                    if (e.key === "/") {
                        e.preventDefault();

                        (
                            document.querySelector(
                                "#search input",
                            ) as HTMLInputElement
                        )?.focus();
                    }
                });

                // @ts-ignore
                const { PagefindUI } = await import("@pagefind/default-ui");

                new PagefindUI({
                    element: "#search",
                    showSubResults: true,
                    translations: {
                        placeholder: "Type / to Search",
                    },
                });
            </script>
        </div>
    </Header>
    <div class="docs-container">
        <div class="docs-sidebar left">
            {
                headings.length ? (
                    <>
                        <div class="docs-sidebar-headings">
                            <h2>On this page</h2>
                            <ul>
                                {headings.map((heading) => (
                                    <li
                                        class={`heading l${heading.depth}`}
                                        data-slug={heading.slug}
                                    >
                                        <a href={`#${heading.slug}`}>
                                            {heading.text}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                        <div class="separator" />
                    </>
                ) : null
            }
            <RecursiveDocsMap
                docsMap={docsMap}
                slug={post}
                level={0}
                client:visible
            />
        </div>
        <div class="docs-content">
            <h1 class="docs-content-title">
                {entry.data.title}
                <div class="read-time">
                    <Icon name="clock" />
                    <span>{time}</span>
                </div>
            </h1>
            <div class="docs-content-description">
                {entry.data.description}
            </div>
            <div class="markdown-body">
                <Content />
            </div>
            <div class="byline">
                <span>Updated on {entry.data.date}</span>
                <a
                    title="Edit on GitHub"
                    target="_blank"
                    href={`https://github.com/relagit/rela.dev/edit/main/src/data/docs/${post}.mdx`}
                >
                    <Icon name="pencil" />
                </a>
                <a
                    title="View on GitHub"
                    target="_blank"
                    href={`https://github.com/relagit/rela.dev/tree/main/src/data/docs/${post}.mdx`}
                >
                    <Icon name="link-external" />
                </a>
                <div class="nav-buttons">
                    <a
                        class="nav-button"
                        aria-label="Previous"
                        href={prev()}
                        aria-disabled={!prev()}
                    >
                        <Icon name="arrow-left" />
                    </a>
                    <a
                        class="nav-button"
                        aria-label="Next"
                        href={next()}
                        aria-disabled={!next()}
                    >
                        <Icon name="arrow-right" />
                    </a>
                </div>
            </div>
        </div>
        <div class="docs-sidebar right">
            {
                headings.length ? (
                    <>
                        <div class="docs-sidebar-headings">
                            <h2>On this page</h2>
                            <ul>
                                {headings.map((heading) => (
                                    <li
                                        class={`heading l${heading.depth}`}
                                        data-slug={heading.slug}
                                    >
                                        <a href={`#${heading.slug}`}>
                                            {heading.text}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    </>
                ) : null
            }
        </div>
    </div>
</Layout>
