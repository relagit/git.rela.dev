---
import * as shikiji from "shikiji";

import "./codeblock.scss";
import cn from "~/utils/cn";

interface Props {
    code: string;
    language: string;
    filename?: string;
    nooverflow?: boolean;
}

const props = Astro.props;

const highlighter = await shikiji.getHighlighter({
    themes: ["github-dark"],
    langs: ["tsx", "ts", "typescript", "js", "javascript"],
});

const code = highlighter.codeToHtml(props.code, {
    lang: props.language,
    theme: "github-dark",
});
---

<div
    class={cn("codeblock", props.nooverflow && "nooverflow")}
    aria-label={`Codeblock showing ${props.filename}`}
    tabindex="0"
>
    {
        props.filename && props.language && (
            <div class="codeblock-header">
                {props.filename && (
                    <div class="codeblock-filename">
                        {props.language === "ts" ? (
                            <svg
                                aria-hidden="true"
                                viewBox="0 0 15 16"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <g clip-path="url(#clip0_811_1349)">
                                    <rect
                                        width="18"
                                        height="18"
                                        transform="translate(0 0.5)"
                                        fill="black"
                                    />
                                    <path
                                        d="M13.5352 0.5H1.46484C0.655833 0.5 0 1.15583 0 1.96484V14.0352C0 14.8442 0.655833 15.5 1.46484 15.5H13.5352C14.3442 15.5 15 14.8442 15 14.0352V1.96484C15 1.15583 14.3442 0.5 13.5352 0.5Z"
                                        fill="currentColor"
                                    />
                                    <path
                                        d="M13.5352 0.5H1.46484C0.655833 0.5 0 1.15583 0 1.96484V14.0352C0 14.8442 0.655833 15.5 1.46484 15.5H13.5352C14.3442 15.5 15 14.8442 15 14.0352V1.96484C15 1.15583 14.3442 0.5 13.5352 0.5Z"
                                        fill="currentColor"
                                    />
                                    <path
                                        fill-rule="evenodd"
                                        clip-rule="evenodd"
                                        d="M9.28532 11.4363V12.9029C9.52374 13.0251 9.80572 13.1167 10.1313 13.1779C10.4568 13.239 10.7999 13.2695 11.1606 13.2695C11.5121 13.2695 11.8461 13.2359 12.1625 13.1687C12.4788 13.1015 12.7562 12.9907 12.9947 12.8364C13.2331 12.6821 13.4218 12.4804 13.5609 12.2314C13.7 11.9824 13.7695 11.6746 13.7695 11.3079C13.7695 11.0421 13.7298 10.8091 13.6503 10.609C13.5708 10.4089 13.4562 10.2309 13.3064 10.0751C13.1567 9.91923 12.9771 9.77942 12.7677 9.65567C12.5583 9.53192 12.3222 9.41506 12.0593 9.30508C11.8667 9.22562 11.694 9.14849 11.5412 9.07363C11.3883 8.99875 11.2584 8.92237 11.1514 8.84447C11.0445 8.76654 10.9619 8.68404 10.9039 8.59697C10.8458 8.50987 10.8167 8.41135 10.8167 8.30134C10.8167 8.20053 10.8427 8.10962 10.8947 8.02864C10.9467 7.94767 11.02 7.87817 11.1148 7.82011C11.2095 7.76207 11.3257 7.71698 11.4632 7.6849C11.6008 7.65282 11.7536 7.6368 11.9217 7.6368C12.044 7.6368 12.1731 7.64597 12.3092 7.66428C12.4452 7.68262 12.582 7.71089 12.7196 7.74906C12.8571 7.78727 12.9908 7.8354 13.1208 7.89344C13.2507 7.9515 13.3706 8.01871 13.4807 8.09512V6.72473C13.2575 6.63918 13.0138 6.57578 12.7494 6.53453C12.485 6.49328 12.1816 6.47266 11.8392 6.47266C11.4907 6.47266 11.1606 6.5101 10.8488 6.58495C10.5371 6.6598 10.2627 6.77667 10.0258 6.93555C9.78891 7.09445 9.6017 7.29686 9.46415 7.54284C9.3266 7.78879 9.25781 8.08287 9.25781 8.42509C9.25781 8.86202 9.38391 9.2348 9.63609 9.54341C9.88825 9.85199 10.2711 10.1132 10.7846 10.3271C10.9864 10.4096 11.1744 10.4906 11.3486 10.57C11.5228 10.6495 11.6734 10.732 11.8002 10.8175C11.9271 10.9031 12.0272 10.9963 12.1006 11.0971C12.1739 11.1979 12.2106 11.3125 12.2106 11.4408C12.2106 11.5356 12.1877 11.6234 12.1418 11.7044C12.096 11.7854 12.0264 11.8556 11.9332 11.9152C11.84 11.9748 11.7238 12.0214 11.5847 12.055C11.4456 12.0886 11.2829 12.1054 11.0964 12.1054C10.7785 12.1054 10.4637 12.0496 10.1519 11.9381C9.84012 11.8266 9.55125 11.6593 9.28532 11.4363ZM6.81973 7.82271H8.70117V6.61914H3.45703V7.82271H5.32928V13.1816H6.81973V7.82271Z"
                                        fill="black"
                                    />
                                </g>
                                <defs>
                                    <clipPath id="clip0_811_1349">
                                        <rect
                                            width="18"
                                            height="18"
                                            fill="white"
                                            transform="translate(0 0.5)"
                                        />
                                    </clipPath>
                                </defs>
                            </svg>
                        ) : null}

                        {props.filename}
                    </div>
                )}
                {props.language && (
                    <div class="codeblock-language">{props.language}</div>
                )}
            </div>
        )
    }
    <div class="codeblock-content" aria-label={props.code} tabindex="0">
        <div class="codeblock-content-inner" set:html={code} />
    </div>
</div>
