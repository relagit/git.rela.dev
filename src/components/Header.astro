---
import Icon, { Discord } from "./Icon";
import Logo from "./Logo.astro";

import "./header.scss";

interface Props {
    embed?: boolean;
    nobg?: boolean;
}

const props = Astro.props;

const isKawaii =
    Astro.url.searchParams.get("kawaii") === "true" ||
    Astro.url.searchParams.get("kawaii") === "" ||
    Astro.url.searchParams.get("uwu") === "true" ||
    Astro.url.searchParams.get("uwu") === "";
---

<script>
    const rcBranding = document.getElementById("rightclick-branding");

    rcBranding?.addEventListener("contextmenu", (e) => {
        e.preventDefault();

        location.pathname = "/docs/press/branding";
    });
</script>

<header class={`nav ${props.embed ? "embed" : ""} ${props.nobg ? "nobg" : ""}`}>
    <div class="nav__content">
        <div class="nav__content__group">
            <a href="/download" class="nav__content__group__link"> Download </a>
            <a href="/enterprise" class="nav__content__group__link">
                Enterprise
            </a>
            <a href="/docs" class="nav__content__group__link docs"
                >Documentation</a
            >
            <a href="/blog" class="nav__content__group__link">Blog</a>
            <div class="nav__content__group__separator"></div>
            <a
                aria-label="Browse Workflows"
                href="https://www.npmjs.com/search?q=relagit"
                class="nav__content__group__link"
            >
                Workflows
            </a>
            <a
                aria-label="Browse Styles"
                href="/styles"
                class="nav__content__group__link"
            >
                Styles
            </a>
        </div>
        <div class="nav__content__group">
            <slot name="search" />
            <a
                href="/redirect/github"
                class="nav__content__group__link hide-docs"
                target="_blank"
            >
                <Icon name="mark-github" />
                <span class="git">relagit/relagit</span>
            </a>
            <a
                href="/redirect/discord"
                aria-label="Discord"
                class="nav__content__group__link hide-docs"
                target="_blank"
            >
                <Discord />
            </a>
            <a
                aria-label="Home"
                href="/"
                class="nav__content__group__link hide-docs"
                id="rightclick-branding"
            >
                {
                    !isKawaii ?
                        <Logo size={16} />
                    :   <img
                            src="/assets/kawaii.svg"
                            alt="Relagit Logo"
                            style="height: 32px;"
                        />
                }
            </a>
        </div>
    </div>
</header>
