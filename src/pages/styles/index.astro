---
import Layout from "~/layouts/Layout.astro";
import DefaultHead from "~/layouts/DefaultHead.astro";
import FakeApp from "./_FakeApp";
import ThemeButton from "./_ThemeButton";

import "./_styles.scss";
import "./_app.scss";

import themes from "./_themes";
---

<Layout>
    <DefaultHead slot="head" title="RelaGit - Styles">
        <link rel="canonical" href="https://rela.dev/styles" />
        <link rel="preload" as="image" href="/assets/client/dark.webp" />
    </DefaultHead>
    <div class="styles">
        <div class="styles-picker">
            <FakeApp client:load />
        </div>
        <div class="styles-selector">
            {
                themes.map((t) => {
                    return <ThemeButton client:load theme={t} />;
                })
            }
        </div>
    </div>
</Layout>
