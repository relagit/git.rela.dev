---
import Header from "~/components/Header.astro";
import Icon from "~/components/Icon";

import Layout from "~/layouts/Layout.astro";
import DefaultHead from "~/layouts/DefaultHead.astro";

import "~/layouts/subpage.scss";
import Button from "~/components/Button";

Astro.response.status = 404;
Astro.response.statusText = "Not found";
---

<Layout>
    <DefaultHead slot="head" title="RelaGit - Not Found" />
    <Header />

    <div class="sub-page nopointer">
        <div class="sub-page__text">
            <h1 class="sub-page__text__heading">404</h1>
            <h2 class="sub-page__text__subheading">
                Are you sure there's meant to be something here? Try again or go
                back.
            </h2>
        </div>
        <Button href="/"> Go back </Button>
    </div>
    <div id="canvas-controls">
        <button id="pause" class="control-button">
            <Icon name="play" />
        </button>
    </div>
    <canvas id="gol" aria-hidden="true" class="decorations"></canvas>
</Layout>

<script>
    import initCanvas from "~/utils/gol";

    const canvas = document.getElementById("gol") as HTMLCanvasElement;

    if (
        canvas &&
        window.matchMedia("(prefers-reduced-motion: no-preference)").matches
    ) {
        const res = initCanvas(canvas);

        res?.init();

        const pauseButton = document.getElementById("pause");

        pauseButton?.addEventListener("click", () => {
            res?.toggle();
        });
    }
</script>
