---
import { Image } from "astro:assets";

import popout from "~/images/popout.png";
import clone from "~/images/clone.png";
import ventura from "~/images/ventura-dark.png";
import decorations from "~/images/hero-decorations.png";

import DefaultHead from "~/layouts/DefaultHead.astro";
import Layout from "~/layouts/Layout.astro";

import Header from "~/components/Header.astro";
import Badge from "~/components/Badge.astro";
import Icon from "~/components/Icon";

import { getReleases } from "~/pages/api/github/release";

import "./_index.scss";
import "./styles/_app.scss";

const version = await getReleases();
---

<script>
    const userAgent = window.navigator.userAgent.toLowerCase();

    let os = "";

    if (userAgent.toLowerCase().includes("win")) {
        os = "windows";
    } else if (userAgent.toLowerCase().includes("mac")) {
        os = "mac";
    } else if (userAgent.toLowerCase().includes("linux")) {
        os = "linux";
    }

    if (
        userAgent.toLowerCase().includes("iphone") ||
        userAgent.toLowerCase().includes("ipad") ||
        userAgent.toLowerCase().includes("android")
    ) {
        os = "mobile";
    }

    const requirements = document.querySelector(".requirements");

    if (requirements) {
        switch (os) {
            case "windows":
                requirements.innerHTML = "Requires Windows 10 or later";
                break;
            case "mac":
                requirements.innerHTML = "Requires macOS 10.14 or later";
                break;
            case "linux":
                requirements.innerHTML = "Available as tarball, .deb, and .rpm";
                break;
            case "mobile":
                requirements.innerHTML =
                    "Download on your desktop to get started";
                break;
        }
    }
</script>

<Layout>
    <DefaultHead slot="head">
        <link rel="canonical" href="https://rela.dev/" />
        <link rel="preload" as="image" href="/assets/client/dark.webp" />
    </DefaultHead>
    <Header />
    <main class="index">
        <div class="hero">
            <!-- null alt on purpose -->
            <Image
                loading="eager"
                decoding="sync"
                src={decorations}
                alt=""
                aria-hidden="true"
                class="hero-decorations"
            />
            <div class="header">
                <h1>Level up your git workflow.</h1>
                <h2>
                    The modern version control client for developers<span
                        >, students, professionals, academics..</span
                    >.
                </h2>
            </div>
            <div class="details">
                <div class="cta">
                    <div class="social-proof">
                        <div class="badges">
                            <Badge
                                top="Product of the Day"
                                bottom="4th"
                                style="gold"
                            />
                            <Badge
                                top="Featured on"
                                bottom="ProductHunt"
                                style="silver"
                            />
                        </div>
                        <div class="separator"></div>
                        <div class="copy">
                            Trusted by students, freelance developers, and
                            industry-leading professionals alike.
                        </div>
                    </div>
                    <div class="buttons">
                        <a class="primary" href="/download">
                            Download
                            <div class="subtext requirements">latest</div>
                        </a>
                        <div class="group">
                            <a class="secondary" href="/redirect/github">
                                View Source
                                <div class="subtext">
                                    <Icon name="mark-github" />
                                    relagit/relagit
                                </div>
                            </a>
                            <Badge
                                top="Product of the Day"
                                bottom="4th"
                                style="gold"
                            />
                        </div>
                    </div>
                </div>
                <div
                    class="frame"
                    role="img"
                    aria-label="The RelaGit client, open to the relagit repository with a file selected, vieewing changes. The window is floating above a blurry vibrant wallpaper."
                >
                    <Image
                        src={ventura}
                        loading="eager"
                        class="wallpaper"
                        alt=""
                    />
                    <div class="window" role="img"></div>
                </div>
            </div>
        </div>
        <section class="feature end">
            <div class="graphic">
                <Image
                    quality="max"
                    src={popout}
                    alt="A native popout window is open above a code editor. The popout shows modified files and commit history."
                />
            </div>
            <div class="info">
                <div class="decoration" style="--color: #F01262"></div>
                <h2 class="header">
                    <span style="--color: #F01262" class="mono">status</span> at
                    a glance
                </h2>
                <p class="description">
                    The information you need, always accessible from the <span
                        class="highlight">Popout</span
                    >.
                </p>
            </div>
        </section>
        <section class="feature">
            <div class="info">
                <div class="decoration" style="--color: #5AC8F5"></div>
                <h2 class="header">
                    <span style="--color: #5AC8F5" class="mono">clone</span> from
                    anywhere
                </h2>
                <p class="description">
                    Your <span class="highlight"
                        >favourite developer platforms</span
                    >, directly integrated into the experience.
                </p>
            </div>
            <div class="graphic">
                <Image
                    quality="max"
                    src={clone}
                    alt="The GitHub vercel/next.js repository being cloned inside RelaGit."
                    class="small"
                />
            </div>
        </section>
    </main>
</Layout>
